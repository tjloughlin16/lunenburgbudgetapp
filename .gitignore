# fy28 app
fy28/node_modules
fy28/dist
fy28/dist-single

# The global gitignore has a bare "data" rule, which silently swallowed the FY28 app's
# only data source. model.json is generated by `python3 model/export.py`, but the npm
# build does not run that — so without it committed, a clean clone cannot build.
!fy28/src/data/
!fy28/src/data/*.json
package/
Lunenburg-FY28-Budget.zip

# Single-file export artifact (built by SINGLE=1 npm run build)
Lunenburg-FY28-Budget/

# Python bytecode
__pycache__/
*.pyc

# Meeting archive: 400MB of scanned agendas and minutes, rebuildable from the town's
# site with `python3 scripts/fetch_agendas.py --from 2025`. The extracted text and the
# index are committed instead — those are what anything actually reads.
sources/meetings/**/*.pdf
!sources/meetings/index.csv

# Same bare "data" rule in the global gitignore also swallowed these. A directory that is
# excluded is never descended into, so re-including the files alone does nothing — the
# directory has to be un-excluded first.
!sources/data/
!sources/data/*.csv
!sources/contracts/data/
!sources/contracts/data/*.csv

# Was covered by the global gitignore, which is gone.
.claude/settings.local.json
incoming/

# wrangler local state (pages dev)
fy28/.wrangler/

# Build comparison artifacts (scripts/compare-experience.mjs)
fy28/dist-plain/
fy28/scratch/

# Derived read model, rebuilt by scripts/build_db.py. Never a source of truth.
sources/data/lunenburg.db

# Published copy of the derived database. Regenerated by scripts/build_api.py; its
# sha256 is committed in fy28/public/api/index.json, so the bytes are still attested.
fy28/public/data/lunenburg.db

# --- The archive's binaries live in R2, not in git -----------------------------------
#
# Every PDF, spreadsheet, Word file and PowerPoint under sources/ is a document somebody
# else published: 1,762 files and 1.38 GB, 92% of the archive's weight and 15% of its
# files. They are in a public, locked R2 bucket, they are served under the same
# /docs/<path> URLs by fy28/functions/docs/_bucket.js, and they are not tracked here.
#
# The index into them is `sources/data/archive-manifest.csv`, which IS tracked -- held
# only in the bucket, a fresh clone would have to ask the network what exists before it
# could ask for any of it. To fill in the files:
#
#     python3 scripts/sync_archive.py --pull
#
# What stays in git is everything that changes: the extracted text, the derived CSVs, the
# analyses, the manifests. A published document does not change, and if our copy ever
# differed from what we uploaded that would be a defect rather than a revision -- which
# is why the bucket freezes them and git versions us.
sources/**/*.pdf
sources/**/*.xls
sources/**/*.xlsx
sources/**/*.doc
sources/**/*.docx
sources/**/*.ppt
sources/**/*.pptx
sources/**/*.html
sources/**/*.zip
sources/**/*.bin
sources/**/*.key

# Except the four documents this project generates itself. They are ours, they change
# when the model does, and git is where a change like that has to show up in a diff.
!sources/analyses/*.pdf
!sources/data/*.xlsx

# The same binaries were also copied into the site build -- 415 files, 722 MB, the
# identical bytes under a second path, so untracking one copy and not the other would
# have saved nothing. build_source_index.py no longer copies them: it publishes what is
# ours and leaves the publishers' files to the bucket.
fy28/public/docs/**/*.pdf
fy28/public/docs/**/*.xls
fy28/public/docs/**/*.xlsx
fy28/public/docs/**/*.doc
fy28/public/docs/**/*.docx
fy28/public/docs/**/*.ppt
fy28/public/docs/**/*.pptx
fy28/public/docs/**/*.html
fy28/public/docs/**/*.zip
fy28/public/docs/**/*.bin
fy28/public/docs/**/*.key
!fy28/public/docs/analyses/*.pdf

# What `sync_archive.py --push` has uploaded and read back. Tracked, not ignored — see
# sources/data/archive-push-state.csv — because `build_archive_guide.py` counts copies
# from it, and a fresh clone that regenerated BACKUP.md without it would report the whole
# archive as existing on one disk.
purge-these-21-urls.txt

# The MCP worker's dependencies.
mcp/node_modules
