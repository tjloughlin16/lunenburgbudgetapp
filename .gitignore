# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Force-include data directories blocked by global gitignore rule for "data"
!public/data/
!public/data/budget.xlsx
!src/data/
!src/data/*.ts

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# fy28 app
fy28/node_modules
fy28/dist
fy28/dist-single

# The global gitignore has a bare "data" rule, which silently swallowed the FY28 app's
# only data source. model.json is generated by `python3 model/export.py`, but the npm
# build does not run that — so without it committed, a clean clone cannot build.
!fy28/src/data/
!fy28/src/data/*.json
package/
Lunenburg-FY28-Budget.zip

# Single-file export artifact (built by SINGLE=1 npm run build)
Lunenburg-FY28-Budget/

# Python bytecode
__pycache__/
*.pyc
