{
 "site": "https://lunenburgbudgetproject.org",
 "promise": "This site is two things. It is an independent analysis of the Lunenburg school budget \u2014 and it publishes the full text of every public meeting of every town board, which covers far more than money: zoning, conservation, health, planning, cemeteries, the library, housing, historical districts. All of it is downloadable data, and every figure traces to a document you can fetch. You do not need to scrape these pages.",
 "warning": "The archive holds both what the town BUDGETED and what it SPENT. They differ by up to 59% on some lines, and a rate measured from one to the other is partly growth and partly the gap between them. Never mix them in one calculation. A budget line is also NET of grants, fees and state aid \u2014 it is not what a thing costs.",
 "answers": [
  {
   "question": "what any town board discussed, and when \u2014 zoning, conservation, health, schools, planning, cemeteries, the library, anything",
   "path": "/minutes/INDEX.txt",
   "note": "then /minutes/<board>.txt \u2014 full text, one file per board"
  },
  {
   "question": "what does the town charge, and when did it change",
   "path": "/data/rate-register.csv",
   "note": "62 rates: athletic and bus fees, contracts, each with the fiscal year it applies to and the document that set it"
  },
  {
   "question": "athletic fees, by year and tier",
   "path": "/data/athletic-fee-schedule.csv",
   "note": "FY24-FY27, most figures checked against a cell or a vote"
  },
  {
   "question": "is the town hoarding free cash, or rebuilding it \u2014 and what it would buy",
   "path": "/docs/analyses/free-cash.md",
   "note": "both claims are true of different windows; the page at /free-cash models drawing the balance down to any level"
  },
  {
   "question": "free cash \u2014 how much the town can spend without raising taxes, and nine towns to compare it with",
   "path": "/data/free-cash-proof.csv",
   "note": "2021-2025; absolute dollars, no denominator, so compare the composition and not the totals"
  },
  {
   "question": "any budget line, any year or scenario",
   "path": "/data/budget-lines.csv",
   "note": "the district budget, line by line, FY23 actuals to FY27 scenarios"
  },
  {
   "question": "HOW a figure was calculated \u2014 the formula, the inputs, and what is assumed",
   "path": "/docs/analyses/show-your-work.md",
   "note": "every calculation opened up, generated from the model itself; read it before reproducing any number here"
  },
  {
   "question": "every figure this site computes, and how",
   "path": "/data/model.json",
   "note": "including citations saying which figures are ours and which are published"
  },
  {
   "question": "every source document, with a hash",
   "path": "/data/sources.json",
   "note": "the full archive catalogue"
  },
  {
   "question": "athletics: what it costs and who pays",
   "path": "/docs/analyses/athletics-ledger.md",
   "note": "and /docs/analyses/athletics.md"
  },
  {
   "question": "special education as a cost driver",
   "path": "/docs/analyses/sped-and-the-curve.md",
   "note": ""
  },
  {
   "question": "how many Lunenburg children are on an IEP, in district and out",
   "path": "/data/sped-students.json",
   "note": "a COUNT OF CHILDREN from DESE. Never divide it into a dollar figure \u2014 the money is a different return with a different census"
  },
  {
   "question": "where Lunenburg resident children actually go to school, and both directions of school choice",
   "path": "/data/sped-leaving.json",
   "note": "a COUNT OF CHILDREN BY DISTRICT, SY2014 onward. It carries NO disability status, so it is not a special education figure"
  },
  {
   "question": "what out-of-district special education costs, split by the fund that paid it, and what the circuit breaker reimburses",
   "path": "/data/sped-cost.json",
   "note": "DOLLARS. The budget line the town votes is the general fund share only; the all-funds figure is larger"
  },
  {
   "question": "the route into out-of-district placement, and the town\u2019s own count of children placed",
   "path": "/data/sped-route.json",
   "note": "PLACEMENTS, on two instruments that do not always agree. The cohort bases are tens of children, so no percentage may be quoted without its count"
  }
 ],
