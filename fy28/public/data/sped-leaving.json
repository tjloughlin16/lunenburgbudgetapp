 "said": [
  {
   "board": "School Committee",
   "cite": "/docs/meetings/text/school-committee/2024-05-01-minutes-6554.txt",
   "date": "2024-05-01",
   "key": "fivethousand",
   "quote": "We receive $5000 per student, however the cost per student is more than that",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_05012024-6554",
   "why": "The district on the money that arrives with a child choosing IN. The counts on this page are children, not dollars; this is the nearest the meeting record comes to a rate, and it is the receiving side rather than the sending side that the town is assessed for."
  },
  {
   "board": "School Committee",
   "cite": "/docs/meetings/text/school-committee/2026-02-04-minutes-7634.txt",
   "date": "2026-02-04",
   "key": "hsonly",
   "quote": "We are looking to only add school choice options to the high school",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_02042026-7634",
   "why": "School choice runs in both directions and the district decides how many seats to OPEN. This page counts only the children going the other way, and the decision quoted here is about the seats coming in."
  }
 ],
