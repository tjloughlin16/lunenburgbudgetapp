  {
   "board": "School Committee",
   "cite": "/docs/meetings/text/school-committee/2025-10-01-minutes-7432.txt",
   "date": "2025-10-01",
   "key": "estimate",
   "quote": "the school budget is based on an estimate of chapter 70 number, this year there is an additional $202,185, in order for the school to get this money it needs to be on the warrant for the Town meeting in November",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_10012025-7432",
   "why": "The town budgets against an ESTIMATE of Chapter 70, and when the real number comes in higher the difference does not simply become school spending. It takes a warrant article at Town Meeting."
  },
  {
   "board": "School Committee",
   "cite": "/docs/meetings/text/school-committee/2026-06-24-minutes-7869.txt",
   "date": "2026-06-24",
   "key": "share",
   "quote": "35% of the entire school budget in Luneburg is covered by chapter 70 funds",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_06242026-7869",
   "why": "A figure stated at a public meeting. It is recomputed from the town\u2019s own revenue and expense ledgers below rather than repeated."
  },
  {
   "board": "School Committee",
   "cite": "/docs/meetings/text/school-committee/2026-04-01-minutes-7748.txt",
