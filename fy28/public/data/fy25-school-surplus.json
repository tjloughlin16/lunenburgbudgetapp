   },
   "custodians": {
    "causes": "custodial vacancies or turnover",
    "settles": "the custodial roster by month, with overtime"
   },
   "equipment": {
    "causes": "purchases deferred, or made from another fund",
    "settles": "the purchase-order list for these accounts"
   },
   "paras": {
    "causes": "aides hired late or not at all, or aides paid from a grant instead",
    "settles": "paraprofessional payroll by month and by funding source"
   },
   "supplies": {
    "causes": "a deliberate hold on purchasing, or purchases made from grants and revolving funds instead",
    "settles": "the general-fund journal detail by month"
   },
   "tuition": {
    "causes": "fewer children placed than budgeted, placements starting later, a placement paid from the circuit breaker fund instead, or a placement billed to a different tuition line",
    "settles": "the placement list by setting, with start dates and the tuition invoice for each"
   },
   "utilities": {
    "causes": "weather, energy prices, or a bill for one year paid in another",
    "settles": "the utility bills by month"
   }
