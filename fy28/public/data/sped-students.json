 "said": [
  {
   "board": "School Committee",
   "cite": "/docs/meetings/text/school-committee/2024-01-24-minutes-6375.txt",
   "date": "2024-01-24",
   "key": "backbone",
   "quote": "they are the backbone of special education and without them the department cannot run",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_01242024-6375",
   "why": "A parent, in the public comment on the FY25 budget, on the proposed paraprofessional cuts. Said in the year between the two largest falls in the state\u2019s own paraprofessional FTE figure for Lunenburg. It establishes that people knew posts were at stake. It does not establish what the FTE return counts, which is the open question beside it."
  },
  {
   "board": "School Committee",
   "cite": "/docs/meetings/text/school-committee/2025-10-01-minutes-7432.txt",
   "date": "2025-10-01",
   "key": "addtwo",
   "quote": "Ms. Brzozoski makes a motion to add two paraprofessional positions where needed, Ms Young seconds the motion, all approve",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_10012025-7432",
   "why": "A vote to ADD posts, in the same school year DESE\u2019s return reports the lowest paraprofessional FTE in the eight years it covers. Both are real. A vote to add positions and a state FTE return are different quantities measured by different people at different moments, and nothing here reconciles them."
  }
 ],
