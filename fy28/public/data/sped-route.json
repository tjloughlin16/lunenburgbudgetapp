 "said": [
  {
   "board": "School Committee",
   "cite": "/docs/meetings/text/school-committee/2026-02-04-minutes-7634.txt",
   "date": "2026-02-04",
   "key": "radar",
   "quote": "we currently have students on our radar that may require out of district placement and we have also had students move into the district that require out of district placements",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_02042026-7634",
   "why": "The second half is the one this page cannot see. A cohort followed from an in-district placement measures the route through the district\u2019s own settings; a child who arrives already placed enters the count without ever appearing in that cohort."
  }
 ],
