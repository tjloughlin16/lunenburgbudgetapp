 "said": [
  {
   "board": "Finance Committee",
   "cite": "/docs/meetings/text/finance-committee/2026-01-27-minutes-7619.txt",
   "date": "2026-01-27",
   "key": "fixed-incomes",
   "kind": "minutes",
   "quote": "particularly seniors on fixed incomes, a $3,000,000 override would translate to approximately $600 per year in additional taxes, a significant burden",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_01272026-7619",
   "why": "A Finance Committee member at the Tri-Board meeting, on whether an override is necessary. This is the claim the income-by-age table can finally be set beside: a household headed by someone 65 or over has a median income a little over half that of a 45-to-64 household. It establishes what was said. It does not establish what any particular household can afford, which no table here measures."
  },
  {
   "board": "Master Plan Steering Committee",
   "cite": "/docs/meetings/text/master-plan-steering-committee/2024-04-05-minutes-6494.txt",
   "date": "2024-04-05",
   "key": "both-halves",
   "kind": "minutes",
   "quote": "young families are looking for smaller houses with some land, but developers are building large houses that young families cannot afford",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_04052024-6494",
   "why": "The Master Plan Steering Committee, in the same minute that records an aging population looking for accessible and affordable options. Both halves of the town appear in one paragraph, which is the shape this page is trying to keep: the same numbers handed to both sides."
  }
