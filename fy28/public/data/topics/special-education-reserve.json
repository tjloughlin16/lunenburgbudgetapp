    ],
    "so": {
     "figures": {},
     "literals": [],
     "text": "Such a move can be seen coming and budgeted the next year; the in-year risk is a child newly placed here."
    },
    "text": "A child already in a private placement who moves in is, by law, the old town’s cost that year."
   },
