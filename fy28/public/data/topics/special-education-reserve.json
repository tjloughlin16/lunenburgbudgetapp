    ],
    "so": {
     "figures": {},
     "literals": [],
     "text": "A spring bill finds the year’s money already committed; that timing, more than the size, is what a reserve covers."
    },
    "text": "When it does, the bill comes late: 92% of orders placed after September came March to June."
   },
   {
    "figures": {},
