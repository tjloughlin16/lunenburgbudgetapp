   "so": {
    "figures": {},
    "literals": [],
    "text": "Budgeting the cushion raises taxes for money that, in most years, is never needed for special education."
   },
   "text": "Added to the budget every year, $223,774 raises $3,804,158 over 17 years to pay $1,235,009 of overspending."
  },
  {
   "figures": {
    "a": {
     "text": "$1,458,783",
     "unit": "",
     "value": 1458783
    },
