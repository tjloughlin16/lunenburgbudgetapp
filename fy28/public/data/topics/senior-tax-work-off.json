   "so": {
    "figures": {},
    "literals": [],
    "text": "The program reaches fewer households than in its first recorded year. No record held says why, and nothing here tests a reason."
   },
   "text": "16 seniors finished the 2010 season; 6 took part in 2025."
  },
  {
   "figures": {
