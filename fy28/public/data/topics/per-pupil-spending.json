   "label": "School Committee minutes, 2024-01-24",
   "quote": "According to Massachusetts State reports Lunenburg per pupil expenditure is listed 361 out of 401 districts in Massachusetts. This means that we're in the top 20% for school performance while being in the bottom 10% for spending"
  },
  {
   "board": "School Committee",
   "date": "2024-01-24",
   "href": "/docs/meetings/text/school-committee/2024-01-24-minutes-6375.txt",
   "label": "School Committee minutes, 2024-01-24",
   "quote": "Lunenburg has a long and well established history of spending little per pupil and still having an amazing school district"
  }
