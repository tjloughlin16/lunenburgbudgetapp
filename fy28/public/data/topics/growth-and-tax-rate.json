 "blocks": [
  {
   "block": "explain",
   "paragraphs": [
    {
     "figures": {},
     "literals": [
      "2.5%",
      "2½"
     ],
     "text": "The town may raise its property tax levy by 2.5% a year (Proposition 2½), plus the tax on new construction, plus anything voters add by override or debt exclusion."
    },
    {
     "figures": {},
     "literals": [],
     "text": "New construction is taxed at the previous year’s rate, and that tax is added to the limit. It adds value and levy together, so on its own it leaves the rate about where it was."
    },
    {
     "figures": {},
     "literals": [],
     "text": "The rate is the levy divided by the value of everything taxed. When existing property gains value faster than the levy grows, the same levy is spread thinner and the rate falls."
    }
   ],
   "place": "lead",
   "title": "Why the rate moves the way it does",
   "tone": "define"
  },
  {
   "block": "chart",
   "place": "body",
   "so": {
