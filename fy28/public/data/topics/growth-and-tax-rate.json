   ],
   "so": {
    "figures": {},
    "literals": [],
    "text": "What development buys is revenue for the town without raising existing bills. That is its case, and it is a real one; a lower rate is not."
   },
   "text": "New growth pays at last year’s rate and adds to the limit beyond 2.5%."
