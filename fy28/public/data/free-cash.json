 "said": [
  {
   "agenda": "b. Local Receipts Trends",
   "beside": "receipts",
   "board": "Finance Committee",
   "cite": "https://lunenburgbudgetproject.org/docs/minutes/text/finance-committee/2026-05-28-minutes-7828.txt",
   "date": "2026-05-28",
   "key": "conservative",
   "quote": "Ana Lockwood states for the last 10 years the town has not collected less than 4 million dollars in local receipts. This year\u2019s estimate is 3.535 million. Ana Lockwood suggests not being so conservative based on the data.",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_05282026-7828"
  },
  {
   "agenda": "c. Discuss FY27 Budget process and improvement ideas",
   "beside": "receipts",
   "board": "Finance Committee",
   "cite": "https://lunenburgbudgetproject.org/docs/minutes/text/finance-committee/2026-05-28-minutes-7828.txt",
   "date": "2026-05-28",
   "key": "review_policy",
   "quote": "Chris Menard suggests having an analyst review all of the town\u2019s policies on free cash and estimates.",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_05282026-7828"
  },
  {
   "agenda": "FY26 Preliminary Budget",
   "beside": "receipts",
   "board": "Select Board",
   "cite": "https://lunenburgbudgetproject.org/docs/minutes/text/select-board/2025-03-11-minutes-7096.txt",
   "date": "2025-03-11",
   "key": "budgeted_conservatively",
   "quote": "Local receipts are budgeted conserva",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_03112025-7096"
  },
  {
   "agenda": "d. FY 25 Budget",
   "beside": "underspend",
   "board": "School Committee",
   "cite": "https://lunenburgbudgetproject.org/docs/minutes/text/school-committee/2025-09-03-minutes-7385.txt",
   "date": "2025-09-03",
   "key": "missing_out",
   "quote": "Ms. Squier shared some of the things her students are missing out on and how hard it has made it, which is disappointing and frustrating based on an unknown surplus of money that was not spent and instead was given back to the town. Mr. Yvon shares some of the positions that were cut and left unfilled and the ability to meet all the students \u2019 needs is harder. Mr. Santry shares we had drastic reductions in services to students. We really could have used those funds to keep some of the positions.",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_09032025-7385"
  },
  {
   "agenda": "",
   "beside": "underspend",
   "board": "School Committee",
   "cite": "https://lunenburgbudgetproject.org/docs/minutes/text/school-committee/2025-09-03-minutes-7385.txt",
   "date": "2025-09-03",
   "key": "not_lost",
   "quote": "With respect to the unspent money, the money is not lost. The money is still there, it is free cash and it is going to roll over. It is going to be appropriated in one fashion or another.",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_09032025-7385"
  },
  {
   "agenda": "FY26 budget gap",
   "beside": "policy",
   "board": "Select Board",
   "cite": "https://lunenburgbudgetproject.org/docs/minutes/text/select-board/2025-03-11-minutes-7096.txt",
   "date": "2025-03-11",
   "key": "stopgap",
   "quote": "The options discussed included a multi-year override or utilizing one-time funds specifically free cash as a stopgap, however these funds should not be used in an operating budget, but as a one-time appropriation.",
   "town": "https://www.lunenburgma.gov/AgendaCenter/ViewFile/Minutes/_03112025-7096"
  },
